diff --git a/gui/ThemeEngine.cpp b/gui/ThemeEngine.cpp
index 118e3ff7..d563acb1 100644
--- a/gui/ThemeEngine.cpp
+++ b/gui/ThemeEngine.cpp
@@ -41,6 +41,7 @@
 #include "image/png.h"
 
 #include "gui/widget.h"
+#include "gui/chtfont.h"
 #include "gui/ThemeEngine.h"
 #include "gui/ThemeEval.h"
 #include "gui/ThemeParser.h"
@@ -1849,10 +1850,30 @@ const Graphics::Font *ThemeEngine::loadFont(const Common::String &filename, cons
 	if (!font && allowNonScalable) {
 		font = loadFont(filename, fontName);
 
-		if (!ConfMan.getBool("gui_disable_fixed_font_scaling"))
+		// CHT: on a cache hit loadFont() hands back whatever is registered under that
+		// name, and a wrapper installed below is not a BdfFont — the cast on the next
+		// line would then make scaleFont read its field layout off an unrelated object.
+		// With the stock themes this does not happen today (FontManager::getFontByName()
+		// answers "clR6x12.bdf" and friends from the builtin fonts and never looks in its
+		// own map), but nothing about that is guaranteed, and the failure would be a wild
+		// pointer. An already wrapped font is finished: no rescaling, no second wrapper.
+		if (!ChtGuiFont::isWrapper(font) && !ConfMan.getBool("gui_disable_fixed_font_scaling"))
 			font = Graphics::BdfFont::scaleFont((const Graphics::BdfFont *)font, pointsize);
 	}
 
+	// CHT: none of the stock GUI fonts carry CJK glyphs, so a game whose name is
+	// written in Chinese lists as a row of empty boxes. When the translation data
+	// is on the search path, wrap the font so anything above U+007F comes from the
+	// ETEN bitmap font instead. Single-byte text keeps rendering through the
+	// original font, and the wrapper reports the original height, so English GUI
+	// text and widget layout are untouched whether or not the file is present.
+	// Wrapping twice would leave two wrappers each owning — and eventually deleting —
+	// the same base font, so a font that came back out of the cache is left alone.
+	if (font && !ChtGuiFont::isWrapper(font)) {
+		if (const Graphics::Font *chtFont = ChtGuiFont::load("kq1_gui.fnt", font))
+			font = chtFont;
+	}
+
 	// If the font is successfully loaded store it in the font manager.
 	if (font) {
 		FontMan.assignFontToName(fontName, font);
